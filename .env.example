# Local development: copy to .env.local. The browser never sees the backend address: it calls this
# app's /api/v1, which next.config.mjs passes on to API_URL.
# Backend origin (with or without /api/v1). Read on the server only. In the Docker image it is a
# build argument (default http://api:8080 on the shared network), because the rewrite is fixed at build.
API_URL=http://localhost:8080
# Public origin, for absolute links in share previews, the sitemap and robots.txt (https:// in production).
SITE_URL=http://localhost:3000
# "production" turns on secure cookie settings outside NODE_ENV=production.
NEXT_PUBLIC_ENV=development
# Cookie domain shared with the backend, e.g. .example.com. Empty: the current host only.
NEXT_PUBLIC_COOKIE_DOMAIN=

# --- Deployment only (docker/docker-compose.prod.yml, set in Dokploy) -------------------------
# Docker Hub account the Deploy workflow pushes capstone-fe to. "latest" follows main.
DOCKER_USERNAME=
IMAGE_TAG=latest
# Host address and port the app is published on. 127.0.0.1 keeps it local; the Tailscale address
# makes it reachable from the tailnet. 3000 is taken by Dokploy on the server.
FE_BIND=127.0.0.1
FE_PORT=3010
FE_MEMORY_LIMIT=512m
